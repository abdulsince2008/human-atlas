{
  "name": "anatomy-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:vercel": "COPY_PUBLIC_DIR=true vite build",
    "check": "tsc --noEmit",
    "lint": "oxlint app web",
    "validate:atlas": "node scripts/validate-atlas.mjs",
    "validate:interactions": "node scripts/validate-interactions.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:assets": "node scripts/validate-platform-registries.mjs --mode=assets",
    "validate:materials": "node scripts/validate-platform-registries.mjs --mode=materials",
    "validate:licenses": "node scripts/validate-platform-registries.mjs --mode=licenses",
    "validate:anatomy": "node scripts/validate-platform-registries.mjs --mode=anatomy",
    "validate:lod": "node scripts/validate-platform-registries.mjs --mode=lod",
    "audit:coverage": "node scripts/audit-anatomy-coverage.mjs",
    "test": "node scripts/test-platform.mjs",
    "validate:all": "npm run check && npm run lint && npm run validate:atlas && npm run validate:interactions && npm run validate:content && npm run validate:assets && npm run validate:materials && npm run validate:licenses && npm run validate:anatomy && npm run validate:lod && npm run audit:coverage && npm test"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.6.1",
    "@shadcn/react": "0.3.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.159.0",
    "@whop/checkout": "^0.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "8.5.2",
    "eslint": "^10.15.0",
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "input-otp": "1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "1.31.0",
    "pg": "^8.23.1",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.159.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "meshoptimizer": "^1.2.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "license": "MIT"
}
